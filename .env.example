# Set to "ollama" for a local Ollama server, "openai-compatible" for a
# self-hosted OpenAI-compatible endpoint, or "none" for the deterministic demo.
PUPIL_LLM_PROVIDER=ollama
PUPIL_LLM_BASE_URL=http://127.0.0.1:11434
PUPIL_LLM_MODEL=qwen3.5:4b-q4_K_M
# Used only by openai-compatible providers. Leave blank for local unauthenticated servers.
PUPIL_LLM_API_KEY=
